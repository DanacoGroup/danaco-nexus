{
  "$description": "Typografia. Nagłówki: Figtree (krój znaku). Interfejs i treść: Inter. Kod: Cascadia Code. Skala: 15 px bazowo, stosunek 1,25 (tercja wielka) od rozmiaru base w górę; rozmiary poniżej base dobrane ręcznie do gęstego interfejsu.",
  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": [
          "Figtree",
          "Inter",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Nagłówki, liczby wyróżnione, ekran powitalny"
      },
      "ui": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Interfejs i treść wiadomości"
      },
      "code": {
        "$type": "fontFamily",
        "$value": [
          "Cascadia Code",
          "JetBrains Mono",
          "ui-monospace",
          "Consolas",
          "monospace"
        ],
        "$description": "Kod, ścieżki, polecenia, wyniki narzędzi"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "size": {
      "2xs": {
        "$type": "dimension",
        "$value": "11px"
      },
      "xs": {
        "$type": "dimension",
        "$value": "12px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "13px"
      },
      "md": {
        "$type": "dimension",
        "$value": "14px"
      },
      "base": {
        "$type": "dimension",
        "$value": "15px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "18px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "22px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "28px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "35px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "44px"
      },
      "5xl": {
        "$type": "dimension",
        "$value": "55px"
      },
      "6xl": {
        "$type": "dimension",
        "$value": "69px"
      },
      "$description": "Skala: 11–15 px dobrane ręcznie do gęstego interfejsu; od 15 px w górę stosunek ok. 1,25 zaokrąglony do pełnych pikseli"
    },
    "line-height": {
      "tight": {
        "$type": "number",
        "$value": 1.1
      },
      "snug": {
        "$type": "number",
        "$value": 1.25
      },
      "normal": {
        "$type": "number",
        "$value": 1.5
      },
      "relaxed": {
        "$type": "number",
        "$value": 1.65
      }
    },
    "letter-spacing": {
      "tighter": {
        "$type": "dimension",
        "$value": "-0.035em"
      },
      "tight": {
        "$type": "dimension",
        "$value": "-0.02em"
      },
      "normal": {
        "$type": "dimension",
        "$value": "0em"
      },
      "wide": {
        "$type": "dimension",
        "$value": "0.04em"
      },
      "caps": {
        "$type": "dimension",
        "$value": "0.08em"
      }
    },
    "numeric": {
      "tabular": {
        "$type": "string",
        "$value": "tabular-nums",
        "$description": "Liczby o stałej szerokości: rozmiary plików, czasy, liczniki, kolumny tabel"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$description": "Nagłówek hero strony produktu",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "{font.size.6xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.tight}",
        "letterSpacing": "{font.letter-spacing.tighter}"
      }
    },
    "h1": {
      "$type": "typography",
      "$description": "Tytuł strony",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "{font.size.4xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.tight}",
        "letterSpacing": "{font.letter-spacing.tighter}"
      }
    },
    "h2": {
      "$type": "typography",
      "$description": "Tytuł sekcji",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "{font.size.3xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.tight}"
      }
    },
    "h3": {
      "$type": "typography",
      "$description": "Nagłówek panelu, powitanie w pustym czacie",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "{font.size.2xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.tight}"
      }
    },
    "h4": {
      "$type": "typography",
      "$description": "Nagłówek karty, okna dialogowego",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.tight}"
      }
    },
    "title": {
      "$type": "typography",
      "$description": "Tytuł elementu listy, rozmowy",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "{font.size.lg}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.tight}"
      }
    },
    "body-lg": {
      "$type": "typography",
      "$description": "Treść wiadomości w czacie",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "{font.size.base}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.relaxed}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "body": {
      "$type": "typography",
      "$description": "Tekst interfejsu",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "body-sm": {
      "$type": "typography",
      "$description": "Opisy, metadane",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "label": {
      "$type": "typography",
      "$description": "Etykieta przycisku, pola, zakładki",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "caption": {
      "$type": "typography",
      "$description": "Podpis, znacznik czasu",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "{font.size.xs}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    },
    "overline": {
      "$type": "typography",
      "$description": "Nagłówek grupy w pasku bocznym, wersaliki",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "{font.size.2xs}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.caps}"
      }
    },
    "code": {
      "$type": "typography",
      "$description": "Kod blokowy i śródtekstowy",
      "$value": {
        "fontFamily": "{font.family.code}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
    }
  }
}
