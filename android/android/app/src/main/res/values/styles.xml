<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Motyw aplikacji: ciemny, jak interfejs Nexusa. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/nexus_side</item>
        <item name="android:statusBarColor">@color/nexus_side</item>
        <item name="android:navigationBarColor">@color/nexus_side</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/nexus_fg</item>
        <item name="android:textColorSecondary">@color/nexus_muted</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Ekran startowy: tło #171717 i ikona Nexusa (Android 12+ SplashScreen, zgodność przez core-splashscreen). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nexus_side</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/nexus_side</item>
        <item name="android:navigationBarColor">@color/nexus_side</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Okna natywne (ustawienia, SMS): ciemny motyw, własny nagłówek w układzie. -->
    <style name="NexusScreen" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/nexus_side</item>
        <item name="colorPrimaryDark">@color/nexus_side</item>
        <item name="colorAccent">@color/nexus_accent</item>
        <item name="android:windowBackground">@color/nexus_app</item>
        <item name="android:statusBarColor">@color/nexus_side</item>
        <item name="android:navigationBarColor">@color/nexus_side</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/nexus_fg</item>
        <item name="android:textColorSecondary">@color/nexus_muted</item>
    </style>

    <!-- Przezroczyste okna pośrednie (zgody, zrzut ekranu, start rozmowy). -->
    <style name="NexusTranslucent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Okno sesji asystenta: przezroczyste, panel na dole ekranu. -->
    <style name="NexusAssistant" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>
