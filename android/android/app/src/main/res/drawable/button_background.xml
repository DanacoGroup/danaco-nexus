<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/nexus_side" />
            <stroke android:width="1dp" android:color="@color/nexus_line" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/nexus_hover" />
            <stroke android:width="1dp" android:color="@color/nexus_line" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/nexus_raised" />
            <stroke android:width="1dp" android:color="@color/nexus_line" />
        </shape>
    </item>
</selector>
