[Unit]
Description=Danaco Nexus — proces roboczy przedsionka (test.danaco-nexus.pl)
Documentation=file:///danaco/projekty/danaco-nexus/deploy/wydania/README.md
After=network-online.target danaco-nexus-postgres.service danaco-nexus-qdrant.service
Wants=network-online.target danaco-nexus-qdrant.service danaco-nexus-languagetool.service
Requires=danaco-nexus-postgres.service
RequiresMountsFor=/danaco/projekty/danaco-nexus
PartOf=danaco-nexus.target

[Service]
Type=simple
User=danaco-serwis
Group=danaco-projekty
UMask=0007
# Kod z wydania stojącego w przedsionku — tak samo jak usługa API przedsionka.
WorkingDirectory=/danaco/projekty/danaco-nexus/wydania/przedsionek/backend
EnvironmentFile=/danaco/projekty/danaco-nexus/.env
EnvironmentFile=/danaco/projekty/danaco-nexus/deploy/wydania/przedsionek.env
Environment=HOME=/danaco/projekty/danaco-nexus/wydania/dane-przedsionek
Environment=PYTHONUNBUFFERED=1
# Przedsionek sprawdza wydanie, nie dźwiga ruchu — jedno zadanie naraz wystarczy.
Environment=NEXUS_WORKER_CONCURRENCY=1
ExecStart=/danaco/projekty/danaco-nexus/.venv/bin/python -m nexus.worker
KillMode=mixed
TimeoutStopSec=120
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/danaco/projekty/danaco-nexus/wydania/dane-przedsionek

[Install]
WantedBy=danaco-nexus.target
