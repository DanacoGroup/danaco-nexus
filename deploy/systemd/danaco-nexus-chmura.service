[Unit]
Description=Danaco Nexus — chmura osobista Nextcloud (FrankenPHP, 127.0.0.1:8940)
Documentation=file:///danaco/projekty/danaco-nexus/README.md
After=network.target danaco-nexus-postgres.service
Requires=danaco-nexus-postgres.service
RequiresMountsFor=/danaco/projekty/danaco-nexus
PartOf=danaco-nexus.target

[Service]
Type=simple
User=danaco-serwis
Group=danaco-projekty
UMask=0007
WorkingDirectory=/danaco/projekty/danaco-nexus/dane/nextcloud/nextcloud
Environment=HOME=/danaco/projekty/danaco-nexus/dane/nextcloud
Environment=XDG_CONFIG_HOME=/danaco/projekty/danaco-nexus/dane/nextcloud/caddy
Environment=XDG_DATA_HOME=/danaco/projekty/danaco-nexus/dane/nextcloud/caddy
Environment=PHP_INI_SCAN_DIR=/danaco/projekty/danaco-nexus/deploy/chmura/php
Environment=TMPDIR=/danaco/projekty/danaco-nexus/dane/tmp
ExecStart=/danaco/programy/frankenphp/frankenphp run \
    --config /danaco/projekty/danaco-nexus/deploy/chmura/Caddyfile --adapter caddyfile
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/danaco/projekty/danaco-nexus/dane/nextcloud /danaco/projekty/danaco-nexus/dane/tmp

[Install]
WantedBy=danaco-nexus.target
