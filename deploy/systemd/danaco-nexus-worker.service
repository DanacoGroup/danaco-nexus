[Unit]
Description=Danaco Nexus — proces roboczy (agent Claude Code CLI + narzędzia MCP)
Documentation=file:///danaco/projekty/danaco-nexus/README.md
After=network-online.target danaco-nexus-postgres.service danaco-nexus-qdrant.service
Wants=network-online.target danaco-nexus-qdrant.service danaco-nexus-languagetool.service
Requires=danaco-nexus-postgres.service
RequiresMountsFor=/danaco/projekty/danaco-nexus
PartOf=danaco-nexus.target

[Service]
Type=simple
User=danaco-serwis
Group=danaco-projekty
UMask=0007
# Kod bierze się z wydania wskazanego przez `wydania/produkcja`, tak samo jak w usłudze API.
# Inaczej proces roboczy — czyli sam agent — chodziłby na stanie roboczym repozytorium:
# na kodzie, który nie przeszedł bramki, i którego nie cofa `cofnij.sh`.
WorkingDirectory=/danaco/projekty/danaco-nexus/wydania/produkcja/backend
EnvironmentFile=/danaco/projekty/danaco-nexus/.env
EnvironmentFile=/danaco/projekty/danaco-nexus/deploy/wydania/produkcja.env
Environment=HOME=/danaco/projekty/danaco-nexus/dane
Environment=PYTHONUNBUFFERED=1
ExecStart=/danaco/projekty/danaco-nexus/.venv/bin/python -m nexus.worker
# Bieżące zadania są dokańczane po SIGTERM; CLI i narzędzia działają w grupach procesów.
KillMode=mixed
TimeoutStopSec=120
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/danaco/projekty/danaco-nexus/dane

[Install]
WantedBy=danaco-nexus.target
