# Danaco Nexus — prywatny asystent AI i chmura osobista.
#   danaco-nexus.pl         → API i interfejs (127.0.0.1:8930)
#   api.danaco-nexus.pl    → samo API (integracje)
#   cloud.danaco-nexus.pl  → Nextcloud na FrankenPHP (127.0.0.1:8940)
# Instalacja: skopiować do /etc/caddy/witryny/ i przeładować Caddy hosta.

(danaco-nexus-naglowki) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Wyszukiwarki widzą wyłącznie stronę produktu; wszystko za logowaniem jest zamknięte.
(danaco-nexus-bez-indeksu) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

danaco-nexus.pl {
	import danaco-nexus-naglowki
	# Ekrany za logowaniem, pobieranie i API poza indeksem; strona produktu („/”) indeksowana.
	@zamkniete path /api/* /zaloguj* /c/* /m/* /pobierz/* /share-target
	header @zamkniete X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	request_body {
		max_size 2GB
	}
	log {
		output file /var/log/caddy/danaco-nexus.access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
	# Krótkie przejście z domeny głównej do chmury (sesja przechodzi dzięki SSO).
	redir /cloud https://cloud.danaco-nexus.pl/ 302
	redir /chmura https://cloud.danaco-nexus.pl/ 302
	reverse_proxy 127.0.0.1:8930 {
		# Strumień zdarzeń zadań (SSE) wymaga natychmiastowego przekazywania danych.
		flush_interval -1
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
}

# Przedsionek: wydanie po bramce, przed produkcją. Nigdy nie trafia do wyszukiwarek
# i jest zamknięty hasłem — to podgląd dla właściciela, a nie druga publiczna witryna.
test.danaco-nexus.pl {
	import danaco-nexus-naglowki
	header X-Robots-Tag "noindex, nofollow, noarchive"
	respond /robots.txt 200 {
		body "User-agent: *\nDisallow: /\n"
	}
	# Hasło obowiązuje wszystkich poza samym serwerem: sprawdzanie wydania przeglądarką
	# uruchomioną lokalnie nie ma jak wypełnić okienka Basic Auth, a ruch z 127.0.0.1
	# i tak nie wychodzi poza tę maszynę.
	@z_zewnatrz not remote_ip 127.0.0.1/32 ::1
	basic_auth @z_zewnatrz {
		import /etc/danaco/przedsionek-haslo
	}
	encode zstd gzip
	request_body {
		max_size 2GB
	}
	log {
		output file /var/log/caddy/danaco-nexus-przedsionek.access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
	reverse_proxy 127.0.0.1:8950 {
		flush_interval -1
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
}

api.danaco-nexus.pl {
	import danaco-nexus-bez-indeksu
	# Tak samo jak domena główna: odpowiedzi JSON integracji potrafią mieć setki kilobajtów,
	# a strumień zdarzeń zadań i tak idzie bez buforowania (flush_interval -1).
	encode zstd gzip
	request_body {
		max_size 2GB
	}
	log {
		output file /var/log/caddy/danaco-nexus-api.access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
	# Samo API (integracje, automatyzacje); interfejs i PWA działają pod domeną główną.
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8930 {
			flush_interval -1
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
	handle {
		redir https://danaco-nexus.pl{uri} 302
	}
}

www.danaco-nexus.pl {
	redir https://danaco-nexus.pl{uri} permanent
}

cloud.danaco-nexus.pl {
	import danaco-nexus-bez-indeksu
	request_body {
		max_size 20GB
	}
	log {
		output file /var/log/caddy/danaco-nexus-chmura.access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
	route {
		# Tożsamość dla chmury nadaje wyłącznie Nexus – nagłówek od klienta jest usuwany.
		request_header -X-Nexus-User
		# Logowanie jednokrotne: sesja Nexusa (ciasteczko domeny danaco-nexus.pl) → konto Nextcloud.
		# Pomijane są ścieżki klientów synchronizacji i udostępnień (własne uwierzytelnianie).
		@przegladarka not path /remote.php/* /public.php/* /ocs/* /status.php /.well-known/* /index.php/login/v2/poll* /login/v2/poll*
		forward_auth @przegladarka 127.0.0.1:8930 {
			uri /api/auth/sso
			copy_headers X-Nexus-User
		}
		reverse_proxy 127.0.0.1:8940 {
			# Duże pliki synchronizacji: bez buforowania i z długimi limitami czasu.
			flush_interval -1
			request_buffers 0
			transport http {
				read_timeout 2h
				write_timeout 2h
			}
		}
	}
}
