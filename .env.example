# Konfiguracja Danaco Nexus (wczytywana przez usługi systemd: EnvironmentFile).
# deploy/instalacja.sh tworzy z tego wzoru plik .env, jeśli go nie ma.
# Plik .env nie trafia do repozytorium i nie zawiera sekretów: baza używa
# uwierzytelniania peer przez gniazdo uniksowe, a token Claude leży w profilu CLI.

# Baza PostgreSQL projektu (własny klaster: dane/postgres, gniazdo w dane/run, port 5433).
NEXUS_DATABASE_URL="postgresql+asyncpg://danaco-serwis@/nexus?host=/danaco/projekty/danaco-nexus/dane/run&port=5433"

# Katalogi: dane aplikacji (pliki, indeks, logi) i zbudowany interfejs.
NEXUS_DATA_DIR=/danaco/projekty/danaco-nexus/dane/app
NEXUS_STATIC_DIR=/danaco/projekty/danaco-nexus/frontend/dist

# Claude Code CLI: program, profil projektu (token OAuth w pliku <profil>/oauth-token),
# model główny i zapasowy, poziom wysiłku (puste = domyślny CLI).
NEXUS_CLAUDE_BIN=/danaco/programy/node/bin/claude
NEXUS_CLAUDE_PROFILE_DIR=/danaco/projekty/danaco-nexus/dane/claude-profil
NEXUS_CLAUDE_MODEL=claude-opus-5
NEXUS_CLAUDE_FALLBACK_MODEL=claude-sonnet-5
NEXUS_CLAUDE_EFFORT=

# Limity: czas jednego zadania agenta i jednego wywołania narzędzia (minuty).
NEXUS_RUN_TIMEOUT_MINUTES=120
NEXUS_TOOL_TIMEOUT_MINUTES=90

# Równoległość: liczba jednocześnie obsługiwanych zadań i wątków narzędzi (OCR).
NEXUS_WORKER_CONCURRENCY=4
NEXUS_TOOL_THREADS=8

# Usługi pomocnicze projektu na pętli zwrotnej.
NEXUS_QDRANT_URL=http://127.0.0.1:6335
NEXUS_LANGUAGETOOL_URL=http://127.0.0.1:8010
# Apache Tika: pusty adres = tika-app w trybie wsadowym (bez osobnej usługi).
NEXUS_TIKA_URL=
NEXUS_TIKA_APP_JAR=/danaco/programy/tika/tika-app-4.0.0.jar
NEXUS_JAVA_BIN=/danaco/programy/java/bin/java
NEXUS_REALESRGAN_DIR=/danaco/programy/realesrgan

# Ciasteczko sesji tylko przez HTTPS (false wyłącznie do testów przez tunel SSH).
NEXUS_COOKIE_SECURE=true
NEXUS_UPLOAD_LIMIT_MB=2048

# Programy narzędziowe (soffice, ffmpeg, node) poza standardową ścieżką.
PATH=/danaco/programy/bin:/danaco/programy/ffmpeg:/danaco/programy/node/bin:/usr/local/bin:/usr/bin:/bin

# Pliki tymczasowe i pamięć podręczna programów (LibreOffice, fontconfig, Java)
# w katalogu projektu na partycji /danaco – duże pliki nie trafiają na partycję systemową.
TMPDIR=/danaco/projekty/danaco-nexus/dane/tmp
XDG_CACHE_HOME=/danaco/projekty/danaco-nexus/dane/.cache

# Chmura osobista (Nextcloud): adres wewnętrzny, adres publiczny (link w interfejsie),
# konto właściciela i plik z hasłem aplikacji Nexusa (tworzy deploy/chmura/konfiguracja.sh).
NEXUS_CHMURA_URL=http://127.0.0.1:8940
NEXUS_CHMURA_PUBLIC_URL=https://cloud.danaco-nexus.pl
NEXUS_CHMURA_USER=admin
NEXUS_CHMURA_TOKEN_FILE=/danaco/projekty/danaco-nexus/dane/app/chmura-token

# Adres publiczny Nexusa i domena ciasteczka sesji. Domena nadrzędna sprawia, że sesja
# Nexusa obejmuje też cloud.danaco-nexus.pl (logowanie jednokrotne do chmury).
NEXUS_PUBLIC_URL=https://danaco-nexus.pl
NEXUS_COOKIE_DOMAIN=danaco-nexus.pl

# Redis (Valkey projektu, gniazdo uniksowe, baza 0): powiadomienia o zdarzeniach zadań.
# Pusty adres = strumienie odpytują bazę.
NEXUS_REDIS_URL=unix:///danaco/projekty/danaco-nexus/dane/run/valkey.sock?db=0

# Rozmowa głosowa. Klucz Google Cloud (Text-to-Speech + Speech-to-Text) zapisuje
# deploy/zapisz-klucz-google.sh; bez klucza działają modele lokalne (Whisper, Piper).
NEXUS_VOICE_GOOGLE_KEY_FILE=/danaco/projekty/danaco-nexus/dane/app/google-api-key
NEXUS_VOICE_DEFAULT=

# --- moduł agenci ---
# Podagenci Claude Code (orkiestracja wielu agentów) i narzędzia sieci (WebSearch, WebFetch).
NEXUS_CLAUDE_SUBAGENTS=true
NEXUS_CLAUDE_WEB_TOOLS=true
# Model podagentów (pusty = jak główny; np. claude-sonnet-5 oszczędza limit konta).
NEXUS_CLAUDE_SUBAGENT_MODEL=
# Górna granica podagentów pracujących naraz w jednym zadaniu (wskazówka dla modelu).
NEXUS_AGENCI_MAX_PODAGENTOW=15
# Tryb badań (research): dłuższy limit czasu zadania (minuty).
NEXUS_RUN_TIMEOUT_RESEARCH_MINUTES=360
# Moduł Kod: autor commitów wykonywanych przez agenta w przestrzeniach projektów.
NEXUS_KOD_GIT_NAME=Danaco Nexus
NEXUS_KOD_GIT_EMAIL=nexus@danaco-nexus.pl
# --- moduł start ---
# Powiadomienia Web Push o zakończonych zadaniach (klucz VAPID tworzony przy starcie API,
# domyślnie dane/app/vapid, prawa 600). Kontakt VAPID: domyślnie NEXUS_PUBLIC_URL.
NEXUS_PUSH_ENABLED=true
#NEXUS_PUSH_VAPID_FILE=/danaco/projekty/danaco-nexus/dane/app/vapid
#NEXUS_PUSH_CONTACT=mailto:adres@domena.pl
# Kto może osadzać kompaktowy panel /?widok=panel w ramce (rozszerzenie, Nexus Desktop).
#NEXUS_PANEL_FRAME_ANCESTORS=* chrome-extension: moz-extension: safari-web-extension: file:
# --- moduł research ---
# Research i Baza wiedzy: limity pobierania stron (web_fetch_page, zapis strony w bazie wiedzy).
NEXUS_RESEARCH_PAGE_MAX_MB=8
NEXUS_RESEARCH_PAGE_MAX_CHARS=200000
NEXUS_RESEARCH_FETCH_TIMEOUT_S=30
# Adres kontaktowy dla OpenAlex i Crossref („polite pool”); pusty = zapytania anonimowe.
NEXUS_RESEARCH_CONTACT_EMAIL=
# Własna instancja SearXNG dla narzędzia web_search; pusty = DuckDuckGo (wersja HTML).
NEXUS_RESEARCH_SEARXNG_URL=
# Opcjonalny klucz Semantic Scholar (zapisuje deploy/zapisz-klucz-semantic-scholar.sh).
NEXUS_RESEARCH_SEMANTIC_SCHOLAR_KEY_FILE=/danaco/projekty/danaco-nexus/dane/app/semantic-scholar-key
