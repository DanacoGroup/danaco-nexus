# Skopiuj do pliku .env i uzupełnij. Plik .env nie trafia do repozytorium.

# Klucz API Anthropic (Claude) – wymagany.
ANTHROPIC_API_KEY=

# Hasło bazy PostgreSQL stosu (dowolny długi losowy ciąg, np. openssl rand -hex 24).
POSTGRES_PASSWORD=

# Model i poziom wysiłku (puste = domyślny "high").
NEXUS_ANTHROPIC_MODEL=claude-opus-5
NEXUS_ANTHROPIC_EFFORT=

# Port na pętli zwrotnej hosta, na który Caddy przekazuje ruch.
NEXUS_PORT=8930

# Katalog danych (baza, pliki, indeks, logi). Na serwerze: partycja /danaco.
NEXUS_DATA_DIR=./data

# Katalog Real-ESRGAN na hoście (plik wykonywalny i modele).
NEXUS_REALESRGAN_HOST_DIR=/danaco/programy/realesrgan

# Równoległość: liczba jednocześnie obsługiwanych zadań i wątków narzędzi (OCR).
NEXUS_WORKER_CONCURRENCY=2
NEXUS_TOOL_THREADS=8

# Ciasteczko sesji tylko przez HTTPS (false wyłącznie do testów przez tunel SSH).
NEXUS_COOKIE_SECURE=true

# Użytkownik i grupa hosta, z których uprawnieniami działają kontenery aplikacji
# (właściciel katalogu danych).
NEXUS_UID=1001
NEXUS_GID=1001
